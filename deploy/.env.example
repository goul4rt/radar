# Copie para .env (chmod 600) e preencha. Nunca versione o .env.
RADAR_DOMINIO=radar.seudominio.com
RADAR_ADMINS=voce@exemplo.com         # e-mails que podem cadastrar rotas que usam credencial do servidor (X)

# Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth (aplicativo da Web)
#   URI de redirecionamento autorizado: https://<RADAR_DOMINIO>/oauth2/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# python3 -c 'import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
COOKIE_SECRET=

# Cloudflare Zero Trust > Networks > Tunnels > Create (Cloudflared) > token; Public hostname -> http://oauth2-proxy:4180
CLOUDFLARE_TUNNEL_TOKEN=

# Opcional: cookie auth_token de uma conta SECUNDÁRIA do X (rotas /twitter). IP de datacenter tem mais bloqueio.
TWITTER_AUTH_TOKEN=
